# Copie para .env e preencha. O .env nunca vai para o git.
GEMINI_API_KEY=
# Opcional. O padrão está em config/rag.yaml; somente o backend lê este valor.
GEMINI_MODEL=gemini-3.5-flash-lite

# Banco vetorial. Mantenha chroma até concluir o tutorial supabase/README.md.
RAG_INDEX_BACKEND=chroma
SUPABASE_URL=
# Chave sb_secret_... ou a legada service_role. Nunca publishable/anon.
SUPABASE_SECRET_KEY=

# No deploy, configurar estas variáveis no ambiente do provedor/contêiner.
# Somente nomes de host, sem https://. Acrescente o domínio público do serviço.
RAG_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Origens completas com protocolo, sem barra final. Inclua a URL pública HTTPS.
RAG_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# No deploy público, acesso autenticado é obrigatório e usa HTTPS.
# Localmente, deixe false. Não envie senhas/tokens ao frontend ou ao Git.
RAG_REQUIRE_AUTH=false
# Mesmo valor em G09_API_TOKEN no backend do coleta-fcte. Gere 32+ caracteres aleatórios.
RAG_API_TOKEN=
# Login HTTP Basic do chat independente online (senha de 16+ caracteres).
RAG_WEB_USER=equipe
RAG_WEB_PASSWORD=
