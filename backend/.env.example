# Copie para .env e preencha. O .env nunca vai para o git.
GEMINI_API_KEY=
# Opcional. O padrão está em config/rag.yaml; somente o backend lê este valor.
GEMINI_MODEL=gemini-3.5-flash-lite

# No deploy, configurar estas variáveis no ambiente do provedor/contêiner.
# Somente nomes de host, sem https://. Acrescente o domínio público do serviço.
RAG_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Origens completas com protocolo, sem barra final. Inclua a URL pública HTTPS.
RAG_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
