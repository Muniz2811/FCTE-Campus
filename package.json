{
  "name": "fcte-campus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:rag": "node scripts/run-rag.mjs servir",
    "rag:prepare": "node scripts/run-rag.mjs preparar",
    "rag:index": "node scripts/run-rag.mjs indexar",
    "rag:check": "node scripts/run-rag.mjs conferir",
    "rag:ask": "node scripts/run-rag.mjs perguntar",
    "test:rag": "node scripts/run-rag.mjs testar"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "5.3.1",
    "lucide-react": "1.71.0",
    "motion": "14.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "description": "Chat da base de conhecimento da FCTE, com fontes e evidencias."
}
